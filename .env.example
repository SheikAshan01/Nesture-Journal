# Nesture Journal - Environment Configuration
# Local Development Only

# PostgreSQL Database Connection
# Standard local PostgreSQL on default port 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nesture_journal?schema=public"

# Application URL
APP_URL="http://localhost:3000"

# Session Secret for custom authentication
SESSION_SECRET="nesture_journal_super_secure_session_secret_2026_dev_key_change_in_prod"

# Local Media Upload Directory (relative to project root)
UPLOAD_DIRECTORY="./public/uploads"

# Node Environment
NODE_ENV="development"
